{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "./out",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "exclude": ["node_modules", ".vscode-test", "out"]
}
